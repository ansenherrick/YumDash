@model ReservationRequestViewModel
@{
    ViewData["Title"] = "Reservations";
}

<h1>Reservation Request</h1>
<form asp-area="" asp-controller="Reservations" asp-action="Create" method="post" class="reservation-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" role="alert"></div>
    <div class="grid">
        <label>Full Name <input asp-for="GuestName" required maxlength="120" /><span asp-validation-for="GuestName"></span></label>
        <label>Email <input asp-for="Email" required /><span asp-validation-for="Email"></span></label>
    </div>
    <div class="grid">
        <label>Phone <input asp-for="Phone" required /><span asp-validation-for="Phone"></span></label>
        <label>Date & Time <input asp-for="ReservationDate" type="datetime-local" required /><span asp-validation-for="ReservationDate"></span></label>
    </div>
    <div class="grid">
        <label>Party Size <input asp-for="PartySize" type="number" min="1" max="24" required /><span asp-validation-for="PartySize"></span></label>
        <label>Estimated Spend / Guest <input asp-for="EstimatedSpendPerGuest" type="number" step="0.01" min="0" max="500" required /><span asp-validation-for="EstimatedSpendPerGuest"></span></label>
    </div>
    <label>Notes (optional) <textarea asp-for="Notes" maxlength="500"></textarea><span asp-validation-for="Notes"></span></label>
    <button type="submit">Send Request</button>
</form>
